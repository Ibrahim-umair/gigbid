APP_ENV=development
APP_SECRET_KEY=replace_me                 # encrypts stored OAuth tokens (Fernet)
REVIEWER_PASSWORD=replace_me
DEMO_PASSWORD=replace_me
GIGBID_LLM=fake                           # fake | openai
OPENAI_API_KEY=
GIGBID_MAX_CALLS=200
MARKETPLACE_MODE=gigsim                   # gigsim | upwork_live
GIGSIM_BASE_URL=inproc                    # or http://gigsim:8081
GIGSIM_API_TOKEN=dev-token
GIGSIM_TOKENS=dev-token:demo,reviewer-token:reviewer
MARKETPLACE_MCP_TOKEN=replace_me          # bearer token for the marketplace MCP HTTP endpoint
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid
GITHUB_TOKEN=                             # GitHub MCP ingestion (read-only)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
CORS_ORIGINS=http://localhost:5173
